# Common container with a ROS Noetic installation.
FROM ros:humble-ros-core as common

# Fix timezones.
ENV TZ=America/New_York
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# Install ROS dependencies.
RUN apt-get update && apt-get install -y \
    ros-humble-image-transport ros-humble-vision-opencv python3-colcon-common-extensions \
    ros-humble-ament-cmake-clang-format ros-humble-ament-cmake-black ros-humble-rosidl-typesupport-c

# Add ros user.
ARG ROS_UID
RUN useradd -m -u $ROS_UID ros

# Container for building the code.
FROM common as builder

# Set up SSH for CLion.
RUN apt-get update && apt-get install -y ssh rsync && rm -rf /var/lib/apt/lists/*
RUN ( \
    echo 'LogLevel DEBUG2'; \
    echo 'PermitRootLogin yes'; \
    echo 'PasswordAuthentication yes'; \
    echo 'Subsystem sftp /usr/lib/openssh/sftp-server'; \
  ) > /etc/ssh/sshd_config_test_clion \
  && mkdir /run/sshd

RUN yes password | passwd ros

# Install libcamera.
RUN apt-get update && apt-get install -y git ninja-build libyaml-dev python3-yaml python3-ply \
    python3-jinja2 libgnutls28-dev openssl libdw-dev libudev-dev python3-pip gcc-12 g++-12 && \
    rm -rf /var/lib/apt/lists/*
RUN update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-12 50
RUN update-alternatives --install /usr/bin/g++ g++ /usr/bin/g++-12 50
RUN pip3 install meson
RUN git clone --depth 1 --branch v0.5.0+rpt20250429 https://github.com/raspberrypi/libcamera.git
RUN cd libcamera \
    && meson build --buildtype=release -Dpipelines=rpi/vc4 -Dipas=rpi/vc4 \
    -Dv4l2=true -Dgstreamer=disabled -Dtest=false -Dlc-compliance=disabled -Dcam=disabled -Dqcam=disabled \
    -Ddocumentation=disabled && \
    ninja -C build install

# Install runtime dependencies.
RUN apt-get update && apt-get install -y libjpeg-dev libtiff-dev libpng-dev libexif-dev libv4l-dev \
    && rm -rf /var/lib/apt/lists/*

# Install ffmpeg.
RUN apt-get update && apt-get install -y ffmpeg && rm -rf /var/lib/apt/lists/*

# Install python dependencies.
ADD scripts/requirements.txt requirements.txt
RUN pip install -r requirements.txt

# For some reason, this header doesn't exist in Docker but is still needed.
ADD external/dma-heap.h /usr/include/linux/dma-heap.h

# Install HAILO dependencies.
WORKDIR /hailo
# hailort
ADD hailort_*.deb hailort.deb
# Hack to get around systemd and sudo requirements
RUN echo '#!/bin/sh\nexec "$@"' > /usr/bin/sudo && chmod +x /usr/bin/sudo
RUN echo '#!/bin/bash\nexit 0' > /usr/bin/systemctl && chmod +x /usr/bin/systemctl
RUN mkdir -p /run/systemd && echo 'docker' > /run/systemd/container
# This will initially fail.
RUN dpkg -i hailort.deb || true
# Update the post-install script.
ADD hailort_postinst.sh /var/lib/dpkg/info/hailort.postinst
# This should succeed now.
RUN dpkg --configure hailort

# TAPPAS
RUN apt-get update && apt-get install -y rsync ffmpeg x11-utils python3-dev python3-pip python3-setuptools \
    python3-virtualenv python-gi-dev libgirepository1.0-dev cmake git libzmq3-dev
ADD tappas_*_linux_installer.zip tappas_linux_installer.zip
RUN apt-get update && apt-get install -y unzip bsdmainutils libcairo2-dev libgstreamer1.0-dev \
    libgstreamer-plugins-base1.0-dev libgstreamer-plugins-bad1.0-dev gstreamer1.0-plugins-good \
    gstreamer1.0-plugins-bad gstreamer1.0-libav gstreamer1.0-tools gstreamer1.0-x
RUN unzip tappas_linux_installer.zip && rm tappas_linux_installer.zip && mv tappas_* tappas
RUN cd tappas && ./install.sh --skip-hailort
# Rejigger some of the install file locations to make them match the Raspberry Pi.
RUN mkdir -p /usr/lib/x86_64-linux-gnu/hailo/tappas/ && \
    cp -R /hailo/tappas/apps/h8/gstreamer/libs/post_processes /usr/lib/x86_64-linux-gnu/hailo/tappas/
RUN mkdir -p /usr/include/hailo/tappas/ && \
    cp -R /hailo/tappas/core/hailo/metadata/* /usr/include/hailo/tappas/ && \
    cp -R /hailo/tappas/core/hailo/general/* /usr/include/hailo/tappas/ && \
    cp -R /hailo/tappas/core/hailo/tracking/* /usr/include/hailo/tappas/ && \
    cp -R /hailo/tappas/core/hailo/libs/postprocesses/* /usr/include/hailo/tappas

# Copy the wrapper script for cmake.
ADD scripts/colcon_cmake.sh /usr/bin/colcon_cmake

CMD ["/usr/sbin/sshd", "-D", "-e", "-f", "/etc/ssh/sshd_config_test_clion"]

# Container for video extraction.
FROM builder as video_extractor

WORKDIR /home/ros/ros_libcamera/
ADD src/ src/
RUN chown -R ros:ros /home/ros/ros_libcamera/

# Build the code.
USER ros

RUN bash -c "source /opt/ros/noetic/setup.bash && colcon build"

# Add scripts to run.
ADD scripts/extract_videos.py extract_videos.py
