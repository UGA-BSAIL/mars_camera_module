<?xml version="1.0"?>
<launch>
    <!-- The name to use for the camera node. -->
    <arg name="node_name" default="camera"/>
    <!-- The frame ID to use for the camera. -->
    <arg name="frame_id" default="frame"/>
    <!-- The ffmpeg encoder name to use. -->
    <arg name="encoder" default="h264_v4l2m2m"/>
    <!-- The file defining the post-processing configuration to use. -->
    <arg name="postprocess_file" default="/usr/share/rpi-camera-assets/ai_pheno/hailo_yolov11_blueberry_inference.json"/>
    <!-- Whether to enable automatic mode selection on the camera sensor. -->
    <arg name="enable_mode_select" default="true"/>
    <!-- Framerate to set for the cameras. -->
    <arg name="frame_rate" default="10"/>

    <!-- Left camera -->
    <include file="$(find libcamera_device)/launch/video.launch">
        <arg name="node_name" value="$(arg node_name)" />
        <arg name="frame_id" value="$(arg frame_id)" />
        <arg name="device_id" value="1"/>
        <arg name="quality" value="4"/>
        <arg name="encoder" value="$(arg encoder)" />
        <!-- Flip the width and height since the cameras are rotated. -->
        <!-- Must be divisible by 32. -->
        <arg name="width" value="1728"/>
        <arg name="height" value="3040"/>
        <arg name="fps" value="$(arg frame_rate)" />
        <arg name="postprocess_file" value="$(arg postprocess_file)" />
        <arg name="enable_mode_select" value="$(arg enable_mode_select)"/>
    </include>
    <!-- Right camera -->
    <include file="$(find libcamera_device)/launch/video.launch">
        <arg name="node_name" value="$(arg node_name)_right" />
        <arg name="frame_id" value="$(arg frame_id)_right" />
        <arg name="device_id" value="0"/>
        <arg name="quality" value="4"/>
        <arg name="encoder" value="$(arg encoder)" />
        <!-- Flip the width and height since the cameras are rotated. -->
        <!-- Must be divisible by 32. -->
        <arg name="width" value="1728"/>
        <arg name="height" value="3040"/>
        <arg name="fps" value="$(arg frame_rate)" />
        <!-- For now, we only run AI phenotyping on the left head. -->
        <arg name="postprocess_file" value="" />
        <arg name="enable_mode_select" value="$(arg enable_mode_select)"/>
    </include>
    <include file="$(find mars_camera_hw_manager)/launch/manager.launch">
        <arg name="camera_id" value="$(arg node_name)" />
    </include>
    <!-- Synchronize cameras -->
    <include file="$(find mars_camera_hw_manager)/launch/camera_sync.launch">
        <arg name="primary_camera_id" value="$(arg node_name)" />
        <arg name="secondary_camera_id" value="$(arg node_name)_right" />
        <arg name="frame_rate" value="$(arg frame_rate)" />
    </include>
</launch>
