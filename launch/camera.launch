<?xml version="1.0"?>
<launch>
    <!-- The name to use for the camera node. -->
    <arg name="node_name" default="camera"/>
    <!-- The frame ID to use for the camera. -->
    <arg name="frame_id" default="frame"/>
    <!-- The ffmpeg encoder name to use. -->
    <arg name="encoder" default="h264_v4l2m2m"/>
    <!-- Path to the directory containing HAILO models. -->
    <arg name="model_dir"/>

    <!-- RGB camera -->
    <include file="$(find libcamera_device)/launch/full_hd_video.launch">
            <arg name="node_name" value="$(arg node_name)" />
            <arg name="frame_id" value="$(arg frame_id)" />
            <arg name="device_id" value="0"/>
            <arg name="quality" value="4"/>
            <arg name="encoder" value="$(arg encoder)" />
            <arg name="fps" value="24" />
    </include>
    <!-- IR camera -->
<!--     <include file="$(find libcamera_device)/launch/full_hd_video.launch"> -->
<!--         <arg name="node_name" value="$(arg node_name)_ir" /> -->
<!--         <arg name="frame_id" value="$(arg frame_id)_ir" /> -->
<!--         <arg name="device_id" value="1"/> -->
<!--         <arg name="quality" value="8"/> -->
<!--         <arg name="encoder" value="$(arg encoder)" /> -->
<!--         <arg name="fps" value="10" /> -->
<!--     </include> -->
    <include file="$(find mars_camera_hw_manager)/launch/manager.launch">
        <arg name="camera_id" value="$(arg node_name)" />
    </include>

    <!-- HAILO flower detection -->
<!--     <include file="$(find hailo_model_runner)/launch/hailo_flower_detection.launch"> -->
<!--     	<arg name="model_dir" value="$(arg model_dir)" /> -->
<!--     	<arg name="camera_id" value="$(arg node_name)" /> -->
<!--     </include> -->
</launch>
